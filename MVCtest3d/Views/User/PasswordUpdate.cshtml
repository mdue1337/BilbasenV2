@model int

@{
    ViewData["Title"] = "PasswordUpdate";
}

<div>
    <p>This is your first time logging in. Please replace your temporary password. </p>
    <div id="errorMessage" style="color: red;"></div>
    <form id="passwordForm" method="post">
        <input type="hidden" name="Id" value="@Model" />
        <label for="Password">New password:</label>
        <input type="password" name="Password"/><br /><br />
        <label for="confirmPSW">Confirm password</label>
        <input type="password" name="confirmPSW" /><br /><br />
        <button type="submit">Submit</button>
    </form>
</div>