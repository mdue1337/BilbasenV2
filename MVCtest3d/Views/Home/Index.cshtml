@model List<ListingModel>

@{
    ViewData["Title"] = "Home Page";
}

@if (TempData["LoginConfirmation"] != null)
{
    <div class="alert alert-good" role="alert">
        @TempData["LoginConfirmation"]
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<style>
    .box {
        border: 1px solid #ccc;
        padding: 10px;
        text-decoration: none;
        color: inherit;
        display: block;
        max-width: 200px;
    }
    .box:hover {
        background-color: #f0f0f0;
    }
</style>

<div class="row">
    @for (int i = 0; i < @Model.Count; i++)
    {
        var columnNumber = i % 3;
        var isFirstColumn = columnNumber == 0;
        
        if (isFirstColumn)
        {
            @:</div><div class="row">
        }

        <div class="col-md-4">
            <a href="@Url.Action("ShowListing", "Shop", new { id = Model[i].Id })" class="box">
                <div class="box">
                    <p>Car: @Model[i].Brand @Model[i].Model</p>
                    <p>Year: @Model[i].Year</p>
                    <p>Price: @Model[i].Price</p>
                </div>
            </a>
        </div>
    }
</div>
