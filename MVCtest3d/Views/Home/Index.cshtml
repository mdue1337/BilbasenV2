@model List<ListingModel>

@{
    ViewData["Title"] = "Home Page";
}

@if (TempData["LoginConfirmation"] != null)
{
    <div class="alert alert-danger" style="background-color: #d4edda; color: black;" role="alert">
        @TempData["LoginConfirmation"]
    </div>
}
else if (TempData["Deletelisting"] != null)
{
    <div class="alert alert-danger" style="background-color: #d4edda; color: black;" role="alert">
        @TempData["Deletelisting"]
    </div>
}
else if (TempData["BuySucess"] != null)
{
    <div class="alert alert-danger" style="background-color: #d4edda; color: black;" role="alert">
        @TempData["BuySucess"]
    </div>
}
else if (TempData["LogOut"] != null)
{
    <div class="alert alert-danger" style="background-color: #d4edda; color: black;" role="alert">
        @TempData["LogOut"]
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<style>
    .box {
        border: 1px solid #ccc;
        padding: 10px;
        text-decoration: none;
        color: inherit;
        display: block;
        max-width: 200px;
    }
    .box:hover {
        background-color: #f0f0f0;
    }
</style>

<div>
    <h2>Welcome to Bilbasen V2</h2>
    <p>This the landing page for our "brugt-bils" hjemmeside</p>
    <nav>
        <p>You can navigate using the bar in the top or using the menu below</p>
        <h4>Navigation</h4>
        <ul>
            @if (Context.Session.GetInt32("UserId") == null)
            {
                <li><a href="@Url.Action("Cars", "Home")">Cars for sale</a></li>
                <li><a href="@Url.Action("SignIn", "User")">Login</a></li>
                <li><a href="@Url.Action("SignUp", "User")">Sign up</a></li>
            }
            else
            {
                <li><a href="@Url.Action("Cars", "Home")">Cars for sale</a></li>
                <li><a href="@Url.Action("Information", "User", new {Id = Context.Session.GetInt32("UserId")})">Dashboard</a></li>
                <li><a href="@Url.Action("CreateListing", "Shop")">Create a new listing</a></li>
                <li><a href="@Url.Action("LogOut", "User")">Sign out</a></li>
            }
        </ul>
    </nav>
</div>
