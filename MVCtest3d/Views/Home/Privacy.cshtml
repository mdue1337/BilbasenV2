﻿@{
    ViewData["Title"] = "Privacy Policy";
}
<div>
    <label for="MessageSender">Sender</label>
    <input id="MessageSender" type="text" />
    <br /><br />
    <label for="MessageInput">Message</label>
    <input id="MessageInput" type="text" />
    <br /><br />
    <button type="submit" id="MessageSendButton">Send Message</button>
</div>

<div>
    <br /><br />
    <ul id="messagesList"></ul>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script defer>
    "use strict";

    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    let chatRoomId;

    document.getElementById("MessageSendButton").disabled = true;

    connection.on("ReceiveMessage", function (user, message) {
        var li = document.createElement("li");
        document.getElementById("messagesList").appendChild(li);
        li.textContent = `${user} says ${message}`;
    });

    connection.start().then(function () {
        document.getElementById("MessageSendButton").disabled = false;

        // Get chatroom
        connection.invoke("GetChatName", [2, 3]).then(function (response) {
            chatRoomId = response;
            connection.invoke("JoinGroup", chatRoomId);
            connection.invoke("GetChatHistory", chatRoomId);
        })
        .catch(function (err) {
            return console.error(err.toString());
        });

    }).catch(function (err) {
        return console.error(err.toString());
    });

    document.getElementById("MessageSendButton").addEventListener("click", function (event) {
        debugger
        var user = parseInt(2) // parseInt(document.getElementById("MessageSender").value);
        var message = document.getElementById("MessageInput").value;
        console.log(chatRoomId)
        connection.invoke("SendMessage", String(chatRoomId), user, message)
        .catch(function (err) {
            return console.error(err.toString());
        });
        debugger
        event.preventDefault();
    });
</script>