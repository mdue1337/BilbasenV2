@model UpdateListingModel

@{
    ViewData["Title"] = "Update Listing";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid black;
        padding: 8px;
        text-align: left;
    }
</style>

<script defer>
    
</script>

<div>
    <h1>Information about @Model.ListingModel.Brand @Model.ListingModel.Model</h1>
    <table>
        <tr>
            <th>Price</th>
            <th>Horsepower</th>
            <th>Year</th>
            <th>Created</th>
        </tr>
        <tr>
            <td>@Model.ListingModel.Price</td>
            <td>@Model.ListingModel.Horsepower</td>
            <td>@Model.ListingModel.Year</td>
            <td>@Model.ListingModel.Created</td>
        </tr>
    </table>

    <h2>Pictures</h2>
    <div id="CarPictures">
        @for (int i = 0; i < Model.PictureModel.Count; i++)
        {
            var base64String = Convert.ToBase64String(Model.PictureModel[i].Data);
            <img src="data:image/jpeg;base64,@base64String" />
        }
    </div>

    <p> If there are no pictures you can upload them below.</p>
    
    
    <form method="post" enctype="multipart/form-data">
        <label for="myFile">Upload a JPEG picture</label>
        <input type="file" id="myFile" name="myFile" accept="image/jpeg" />
        <input type="hidden" name="ListingId" value="@Model.ListingModel.Id"/>
        <input type="submit" />
    </form>
</div>