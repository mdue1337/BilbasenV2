@model UpdateListingModel

@{
    ViewData["Title"] = "Update Listing";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid black;
        padding: 8px;
        text-align: left;
    }
</style>

<script defer>
    
</script>

<div>
    <h1>Information about @Model.ListingModel.Brand @Model.ListingModel.Model</h1>
    <p>Unfortunately you cannot change any information about your listing.</p>
    <table>
        <tr>
            <th>Price</th>
            <th>Horsepower</th>
            <th>Year</th>
            <th>Created</th>
            <th>Location</th>
        </tr>
        <tr>
            <td>@Model.ListingModel.Price</td>
            <td>@Model.ListingModel.Horsepower</td>
            <td>@Model.ListingModel.Year</td>
            <td>@Model.ListingModel.Created</td>
            <td>@Model.ListingModel.Location</td>
        </tr>
    </table>

    <h2>Pictures</h2>
    <p> However you can add pictures :) </p>
    <br />
    <div id="CarPictures">
        @for (int i = 0; i < Model.PictureModel.Count; i++)
        {
            var base64String = Convert.ToBase64String(Model.PictureModel[i].Data);
            <img id="picture{@i}" src="data:image/jpeg;base64,@base64String" />
        }
    </div>

    <form method="post" enctype="multipart/form-data">
        <label for="myFile">Upload a JPEG picture</label>
        <input type="file" id="myFile" name="myFile" accept="image/jpeg" required/>
        <input type="hidden" name="ListingId" value="@Model.ListingModel.Id"/>
        <input type="submit" />
    </form>

    <br /><br />

    <div>
        <h4>Delete your listing</h4>
        <p>If you listing hasn't sold yet you can delete it</p>
        <h3>!!THIS ACTION CANNOT BE UNDONE!!!</h3>
        <button><a href="@Url.Action("DeleteListing", "Shop", new { listingId = Model.ListingModel.Id })">Delete listing</a></button>
    </div>
</div>