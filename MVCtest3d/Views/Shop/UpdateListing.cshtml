@model UpdateListingModel

@{
    ViewData["Title"] = "Update Listing";
}

<style>
    .no {
        color: #FFFFFF;
        text-decoration: none;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid black;
        padding: 8px;
        text-align: left;
    }

    .picture-wrapper {
        position: relative;
        display: inline-block;
    }

    .delete-button {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: red;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        display: none;
    }

    .picture-wrapper:hover .delete-button {
        display: block;
    }
</style>

<script defer>
    function validateForm() {
        let price = document.forms["change"]["Price"].value;
        let description = document.forms["change"]["Description"].value;

        if (price === "" && description === "") {
            alert("Please fill out at least one field.");
            return false;
        }

        return true;
    }

    function handleDelete() {
        if (confirmDelete()) {
            // If user confirms deletion, proceed to delete action
            window.location.href = '@Url.Action("DeleteListing", "Shop", new { listingId = Model.ListingModel.Id })';
        }
    }

    function confirmDelete() {
        return confirm('Are you sure you want to delete this?');
    }
</script>

<div>
    <h1>Information about @Model.ListingModel.Brand @Model.ListingModel.Model</h1>
    <table>
        <tr>
            <th>Price</th>
            <th>Horsepower</th>
            <th>Year</th>
            <th>Created</th>
            <th>Location</th>
            <th>Description</th>
        </tr>
        <tr>
            <td>@Model.ListingModel.Price</td>
            <td>@Model.ListingModel.Horsepower</td>
            <td>@Model.ListingModel.Year</td>
            <td>@Model.ListingModel.Created</td>
            <td>@Model.ListingModel.Location</td>
            <td>@Model.ListingModel.Description</td>
        </tr>
    </table>

    @{
        if (Model.ListingModel.Status is not false)
        {
            <h2>Change current information</h2>
            <form name="change" action="@Url.Action("ChangeListingInfo", "Shop")" method="POST" onsubmit="return validateForm()">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ListingId" value="@Model.ListingModel.Id" />
                <label>New price:</label>
                <input name="Price" type="number" min="1" /><br /><br />
                <label>New description:</label>
                <input name="Description" type="text" maxlength="256" /><br /><br />
                <button type="submit"> Send </button>
            </form>
        }
    }

    <h2>Pictures</h2>
    <div id="CarPictures">
        @for (int i = 0; i < Model.PictureModel.Count; i++)
        {
            var base64String = Convert.ToBase64String(Model.PictureModel[i].Data);
            var deleteUrl = Url.Action("DeletePicture", "Shop");

            <div class="picture-wrapper">
                <img id="picture{@i}" src="data:image/jpeg;base64,@base64String" />
                <form action="@deleteUrl" method="post" style="display:inline;" onsubmit="return confirmDelete()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PictureId" value="@Model.PictureModel[i].Id" />
                    <input type="hidden" name="ListingId" value="@Model.ListingModel.Id" />
                    <button type="submit" class="delete-button">Delete?</button>
                </form>
            </div>
        }
    </div>

    <form method="post" enctype="multipart/form-data">
        <label for="myFile">Upload a JPEG picture</label>
        <input type="file" id="myFile" name="myFile" accept="image/jpeg" required />
        <input type="hidden" name="ListingId" value="@Model.ListingModel.Id" />
        <input type="submit" />
    </form>

    <br /><br />

    @{
        if (Model.ListingModel.Status is not false)
        {
            <div>
                <h4>Delete your listing</h4>
                <button onclick="handleDelete()"> Delete listing</button>
            </div>
        }
    }
</div>